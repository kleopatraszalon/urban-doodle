# Admin felület védelme
ADMIN_TOKEN=change-me-to-a-long-random-value

# Shoprenter – ajánlott OAuth2 kliens (Beállítások > API beállítások)
SHOPRENTER_SHOP_NAME=your-shoprenter-shop-name
SHOPRENTER_CLIENT_ID=
SHOPRENTER_CLIENT_SECRET=

# Opcionális régi Basic Auth, ha az adott bolt még ezt használja
# SHOPRENTER_API_USERNAME=
# SHOPRENTER_API_PASSWORD=

# eMAG Hungary API
EMAG_API_BASE=https://marketplace-api.emag.hu/api-3
EMAG_API_USERNAME=
EMAG_API_PASSWORD=

# Ha az automatikus 27%-os VAT felismerés nem sikerül, add meg kézzel
# EMAG_VAT_ID=
EMAG_WAREHOUSE_ID=0
EMAG_HANDLING_TIME=1
EMAG_MIN_PRICE_FACTOR=0.8
EMAG_MAX_PRICE_FACTOR=1.5
